{
  "name": "keyring-backend",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "version": "0.1.0",
  "type": "module",
  "description": "KeyRing REST API using NestJS, TypeORM and SQLite.",
  "scripts": {
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "migration:generate": "pnpm build && typeorm migration:generate -d dist/database/data-source.js",
    "migration:run": "pnpm build && typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "pnpm build && typeorm migration:revert -d dist/database/data-source.js",
    "test:integration": "node test/auth.integration.mjs && node test/seed.integration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.2",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.72.1"
  }
}
