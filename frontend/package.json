{
  "name": "keyring",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{js,ts,json,md}\"",
    "verify:servicios": "esbuild .verify/servicios.ts --bundle --format=esm --platform=node --outfile=.verify/out-servicios.mjs && node .verify/run-servicios.mjs",
    "verify:guards": "node .verify/build-guards.mjs && node .verify/run-guards.mjs",
    "verify:vistas": "node .verify/build-vistas.mjs && node .verify/run-vistas.mjs",
    "verify": "npm run verify:servicios && npm run verify:guards && npm run verify:vistas"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "leaflet": "^1.9.4",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-chartjs": "^5.3.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.12",
    "@vitejs/plugin-vue": "^5.1.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.27.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.1.6"
  }
}
