# Environment variable template. Copy this file to .env and adjust the values;
# the real .env is not versioned. Only variables with the VITE_ prefix reach the
# browser, so never put anything sensitive here.
#
# Values are read in src/config/app.config.ts, the only place in the project
# that touches import.meta.env.

# Application name: shown in the browser tab and in the UI.
VITE_APP_NAME=KeyRing

# Property map tile template. Allows switching providers without touching view code.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# API endpoint embedded in the frontend at build time.
VITE_API_BASE_URL=http://localhost:3000
